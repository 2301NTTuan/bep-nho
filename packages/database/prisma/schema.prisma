generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  authSubject   String          @unique @map("auth_subject") @db.VarChar(191)
  status        String          @default("active") @db.VarChar(24)
  locale        String          @default("vi-VN") @db.VarChar(16)
  timezone      String          @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cookSessions  CookSession[]
  tasteProfiles TasteProfile[]
  credential    UserCredential?
  authSessions  AuthSession[]

  personalizedRecipeVersions PersonalizedRecipeVersion[]

  @@map("users")
}

model UserCredential {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  normalizedEmail String   @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Recipe {
  id                         String                      @id @default(uuid()) @db.Uuid
  slug                       String                      @unique @db.VarChar(180)
  canonicalTitle             String                      @map("canonical_title") @db.VarChar(180)
  status                     String                      @default("draft") @db.VarChar(24)
  cuisine                    String                      @default("vietnamese") @db.VarChar(64)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions                   RecipeVersion[]
  personalizedRecipeVersions PersonalizedRecipeVersion[]

  @@index([status, canonicalTitle])
  @@map("recipes")
}

model RecipeVersion {
  id              String    @id @default(uuid()) @db.Uuid
  recipeId        String    @map("recipe_id") @db.Uuid
  versionNo       Int       @map("version_no")
  servings        Decimal   @db.Decimal(6, 2)
  prepTimeMinutes Int?      @map("prep_time_minutes")
  cookTimeMinutes Int?      @map("cook_time_minutes")
  summary         String?
  contentHash     String    @map("content_hash") @db.VarChar(64)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)

  recipe       Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  cookSessions CookSession[]

  adjustmentRules RecipeAdjustmentRule[]

  personalizedVersions PersonalizedRecipeVersion[]

  @@unique([recipeId, versionNo])
  @@index([recipeId, publishedAt])
  @@map("recipe_versions")
}

model CookSession {
  id                          String                     @id @default(uuid()) @db.Uuid
  userId                      String                     @map("user_id") @db.Uuid
  recipeVersionId             String                     @map("recipe_version_id") @db.Uuid
  personalizedRecipeVersionId String?                    @map("personalized_recipe_version_id") @db.Uuid
  status                      String                     @default("started") @db.VarChar(24)
  servings                    Decimal                    @db.Decimal(6, 2)
  syncVersion                 Int                        @default(1) @map("sync_version")
  snapshotJson                Json?                      @map("snapshot_json")
  startedAt                   DateTime                   @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt                 DateTime?                  @map("completed_at") @db.Timestamptz(6)
  user                        User                       @relation(fields: [userId], references: [id])
  recipeVersion               RecipeVersion              @relation(fields: [recipeVersionId], references: [id])
  personalizedRecipeVersion   PersonalizedRecipeVersion? @relation(fields: [personalizedRecipeVersionId], references: [id], onDelete: Restrict)
  feedback                    CookFeedback?
  events                      CookEvent[]

  @@index([userId, startedAt])
  @@index([personalizedRecipeVersionId])
  @@map("cook_sessions")
}

model CookEvent {
  id            String      @id @db.Uuid
  cookSessionId String      @map("cook_session_id") @db.Uuid
  eventType     String      @map("event_type") @db.VarChar(64)
  clientSeq     Int         @map("client_seq")
  clientTime    DateTime    @map("client_time") @db.Timestamptz(6)
  serverTime    DateTime    @default(now()) @map("server_time") @db.Timestamptz(6)
  payload       Json
  schemaVersion Int         @default(1) @map("schema_version")
  cookSession   CookSession @relation(fields: [cookSessionId], references: [id])

  @@unique([cookSessionId, clientSeq])
  @@map("cook_events")
}

model CookFeedback {
  id             String        @id @default(uuid()) @db.Uuid
  cookSessionId  String        @unique @map("cook_session_id") @db.Uuid
  overallScore   Decimal?      @map("overall_score") @db.Decimal(3, 1)
  dimensionJson  Json          @map("dimension_json")
  technicalFlags Json          @map("technical_flags")
  privateNote    String?       @map("private_note")
  revisionNo     Int           @default(1) @map("revision_no")
  submittedAt    DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  cookSession    CookSession   @relation(fields: [cookSessionId], references: [id])
  tasteSignals   TasteSignal[]

  @@map("cook_feedback")
}

model TasteProfile {
  id                         String                      @id @default(uuid()) @db.Uuid
  userId                     String                      @map("user_id") @db.Uuid
  algorithmVersion           String                      @map("algorithm_version") @db.VarChar(32)
  maturityScore              Decimal                     @default(0) @map("maturity_score") @db.Decimal(5, 4)
  sampleCount                Int                         @default(0) @map("sample_count")
  computedAt                 DateTime                    @default(now()) @map("computed_at") @db.Timestamptz(6)
  user                       User                        @relation(fields: [userId], references: [id])
  dimensions                 TasteDimension[]
  signals                    TasteSignal[]
  personalizedRecipeVersions PersonalizedRecipeVersion[]

  @@unique([userId, algorithmVersion])
  @@index([userId])
  @@map("taste_profiles")
}

model TasteDimension {
  tasteProfileId  String       @map("taste_profile_id") @db.Uuid
  dimensionKey    String       @map("dimension_key") @db.VarChar(64)
  scopeType       String       @default("global") @map("scope_type") @db.VarChar(24)
  scopeId         String       @default("") @map("scope_id") @db.VarChar(191)
  score           Decimal      @default(0) @db.Decimal(6, 5)
  confidence      Decimal      @default(0) @db.Decimal(5, 4)
  effectiveWeight Decimal      @default(0) @map("effective_weight") @db.Decimal(10, 4)
  sampleCount     Int          @default(0) @map("sample_count")
  manualOverride  Decimal?     @map("manual_override") @db.Decimal(6, 5)
  tasteProfile    TasteProfile @relation(fields: [tasteProfileId], references: [id])

  @@id([tasteProfileId, dimensionKey, scopeType, scopeId])
  @@map("taste_dimensions")
}

model TasteSignal {
  id             String        @id @default(uuid()) @db.Uuid
  tasteProfileId String        @map("taste_profile_id") @db.Uuid
  cookFeedbackId String?       @map("cook_feedback_id") @db.Uuid
  dimensionKey   String        @map("dimension_key") @db.VarChar(64)
  signalValue    Decimal       @map("signal_value") @db.Decimal(6, 5)
  sourceType     String        @map("source_type") @db.VarChar(32)
  baseWeight     Decimal       @map("base_weight") @db.Decimal(7, 4)
  qualityFactor  Decimal       @map("quality_factor") @db.Decimal(6, 5)
  excludedReason String?       @map("excluded_reason") @db.VarChar(120)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tasteProfile   TasteProfile  @relation(fields: [tasteProfileId], references: [id])
  cookFeedback   CookFeedback? @relation(fields: [cookFeedbackId], references: [id], onDelete: Restrict)

  @@index([tasteProfileId, dimensionKey, createdAt])
  @@index([cookFeedbackId])
  @@map("taste_signals")
}

model Ingredient {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(180)
  canonicalName String   @map("canonical_name") @db.VarChar(180)
  category      String?  @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recipeIngredients     RecipeIngredient[]
  recipeAdjustmentRules RecipeAdjustmentRule[]

  @@index([canonicalName])
  @@map("ingredients")
}

model RecipeIngredient {
  id                String   @id @default(uuid()) @db.Uuid
  recipeVersionId   String   @map("recipe_version_id") @db.Uuid
  ingredientId      String   @map("ingredient_id") @db.Uuid
  quantity          Decimal  @db.Decimal(10, 3)
  unit              String   @db.VarChar(32)
  preparation       String?  @db.VarChar(255)
  note              String?  @db.VarChar(255)
  sortOrder         Int      @map("sort_order")
  scalingMode       String   @default("LINEAR") @map("scaling_mode") @db.VarChar(16)
  scalingExponent   Decimal  @default(1) @map("scaling_exponent") @db.Decimal(4, 3)
  roundingIncrement Decimal? @map("rounding_increment") @db.Decimal(10, 3)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@unique([recipeVersionId, sortOrder])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id              String  @id @default(uuid()) @db.Uuid
  recipeVersionId String  @map("recipe_version_id") @db.Uuid
  stepNo          Int     @map("step_no")
  instruction     String
  durationSeconds Int?    @map("duration_seconds")
  heatLevel       String? @map("heat_level") @db.VarChar(32)
  tip             String?

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)

  @@unique([recipeVersionId, stepNo])
  @@map("recipe_steps")
}

model RecipeAdjustmentRule {
  id              String @id @default(uuid()) @db.Uuid
  recipeVersionId String @map("recipe_version_id") @db.Uuid
  ingredientId    String @map("ingredient_id") @db.Uuid
  dimensionKey    String @map("dimension_key") @db.VarChar(64)

  sensitivity Decimal @db.Decimal(6, 5)
  minFactor   Decimal @default(0.75) @map("min_factor") @db.Decimal(6, 5)
  maxFactor   Decimal @default(1.25) @map("max_factor") @db.Decimal(6, 5)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeVersionId, ingredientId, dimensionKey])
  @@index([recipeVersionId])
  @@map("recipe_adjustment_rules")
}

model PersonalizedRecipeVersion {
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @map("user_id") @db.Uuid
  recipeId            String @map("recipe_id") @db.Uuid
  baseRecipeVersionId String @map("base_recipe_version_id") @db.Uuid
  tasteProfileId      String @map("taste_profile_id") @db.Uuid

  versionNo        Int    @map("version_no")
  algorithmVersion String @map("algorithm_version") @db.VarChar(32)
  contentHash      String @map("content_hash") @db.VarChar(64)

  adjustmentJson Json     @map("adjustment_json")
  snapshotJson   Json     @map("snapshot_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe            Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  baseRecipeVersion RecipeVersion @relation(fields: [baseRecipeVersionId], references: [id], onDelete: Restrict)
  tasteProfile      TasteProfile  @relation(fields: [tasteProfileId], references: [id], onDelete: Restrict)

  cookSessions CookSession[]

  @@unique([userId, recipeId, versionNo])
  @@unique([userId, recipeId, contentHash])
  @@index([userId, recipeId, createdAt])
  @@map("personalized_recipe_versions")
}
