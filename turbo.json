{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "CORS_ORIGIN",
    "NEXT_PUBLIC_API_BASE_URL",
    "AUTH_RATE_LIMIT_LOGIN_POINTS",
    "AUTH_RATE_LIMIT_REGISTER_POINTS",
    "AUTH_RATE_LIMIT_LIFECYCLE_REQUEST_POINTS",
    "AUTH_RATE_LIMIT_LIFECYCLE_CONFIRM_POINTS",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS",
    "AUTH_RATE_LIMIT_KEY_PREFIX",
    "TRUST_PROXY_HOPS",
    "LOG_LEVEL",
    "OPENAPI_ENABLED",
    "METRICS_ENABLED",
    "PUBLIC_WEB_URL",
    "MAIL_TRANSPORT",
    "MAIL_FROM",
    "MAIL_SMTP_HOST",
    "MAIL_SMTP_PORT",
    "MAIL_SMTP_SECURE",
    "MAIL_SMTP_USERNAME",
    "MAIL_SMTP_PASSWORD",
    "DEV_MAIL_OUTBOX_KEY"
  ],
  "tasks": {
    "dev": {"cache": false, "persistent": true},
    "build": {"dependsOn": ["^build"], "outputs": [".next/**", "dist/**"]},
    "lint": {"dependsOn": ["^lint"]},
    "typecheck": {"dependsOn": ["^typecheck"]},
    "test": {"dependsOn": ["^build"], "outputs": ["coverage/**"]}
  }
}
